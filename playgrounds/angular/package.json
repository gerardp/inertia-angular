{
  "name": "inertia-angular-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ng build --watch --configuration development",
    "build": "ng build --configuration production && ng build --configuration ssr && node scripts/finalize-ssr.mjs",
    "test:browser": "pnpm build && playwright test",
    "type-check": "ng build --configuration development"
  },
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/platform-server": "22.2.1",
    "@angular/ssr": "22.2.1",
    "inertia-angular": "workspace:*",
    "@inertiajs/core": "workspace:*",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@playwright/test": "1.58.2",
    "@types/node": "^24.10.13",
    "@tailwindcss/postcss": "^4.2.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2"
  },
  "packageManager": "pnpm@11.1.1"
}
