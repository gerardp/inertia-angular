{
  "name": "inertia-angular-test-app",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration development",
    "build": "ng build --configuration production && ng build --configuration unified && node scripts/fix-index-placeholders.mjs",
    "build:ssr": "ng build --configuration ssr && node scripts/finalize-ssr.mjs",
    "lint": "oxlint src",
    "type-check": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false"
  },
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/platform-server": "22.2.1",
    "@angular/ssr": "22.2.1",
    "inertia-angular": "workspace:*",
    "@inertiajs/core": "workspace:*",
    "axios": "^1.17.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "jsdom": "^28.0.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2"
  }
}
